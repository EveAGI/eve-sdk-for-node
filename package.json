{
  "name": "eveai-gugotik-sdk",
  "homepage": "https://github.com/GuGoTik/backend",
  "description": "Eve.AI + GuGoTik Node.js SDK - Complete SDK for Eve.AI marketplace and GuGoTik social platform with AI-powered task management, payments, chat, and provider discovery",
  "version": "2.0.0",
  "license": "BSD-3-Clause",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsup"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./file": {
      "import": {
        "types": "./dist/inputFile.d.mts",
        "default": "./dist/inputFile.mjs"
      },
      "require": {
        "types": "./dist/inputFile.d.ts",
        "default": "./dist/inputFile.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/GuGoTik/backend"
  },
  "keywords": [
    "eveai",
    "eve.ai",
    "marketplace",
    "ai",
    "gpt-4",
    "whisper",
    "provider-discovery",
    "task-management",
    "payments",
    "stripe",
    "chat",
    "real-time",
    "gugotik",
    "tiktok",
    "video",
    "social",
    "microservices",
    "sdk",
    "nodejs",
    "typescript"
  ],
  "devDependencies": {
    "@types/node": "20.11.25",
    "tsup": "7.2.0",
    "esbuild-plugin-file-path-extensions": "^2.0.0",
    "tslib": "2.6.2",
    "typescript": "5.4.2"
  },
  "dependencies": {
    "node-fetch-native-with-agent": "1.7.2"
  }
}
